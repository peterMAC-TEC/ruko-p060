# Copy to .env.local and fill in what you have. Everything runs without keys
# in demo mode; each service switches on when its keys are present.
# .env.local is git-ignored, so keys never get committed.

# Flags (defaults shown). Keep all three on until real services are wired in.
DEMO_MODE=true
MOCK_TELEPHONY=true
MOCK_SIGNALS=true

# Claude: Ruko voice check risk scoring and the scam-simulator agent
ANTHROPIC_API_KEY=

# Supabase: database + Realtime (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sarvam AI: Indian-language speech to text and text to speech
SARVAM_API_KEY=

# ElevenLabs: English voices
ELEVENLABS_API_KEY=

# Vapi: phone-call agent for the one real call per participant
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# Twilio: family alert calls and SMS (international route; no DLT needed)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Not used: MSG91 and Exotel need Indian DLT/business registration (see docs/DECISIONS.md)
